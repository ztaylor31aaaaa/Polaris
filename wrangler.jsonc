{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polaris",
  "main": "./_worker.js",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "POLARIS_STATE",
        "class_name": "PolarisState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PolarisState"
      ]
    }
  ],
  "build": {
    "command": "npm run build"
  }
}
