{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polaris",
  "main": "./_worker.js",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "build": {
    "command": "npm run build:proxy"
  }
}
